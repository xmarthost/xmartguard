# Block all access except from specified IPs
Order Deny,Allow
Deny from all
Allow from 182.176.167.142
Allow from 202.163.123.6
Allow from 157.180.4.221
Allow from 91.230.49.19

# Alternative method using mod_authz_core (Apache 2.4+)
# <RequireAll>
#     Require ip 182.176.167.142
#     Require ip 202.163.123.6
# </RequireAll>

# Additional LiteSpeed optimization directives
<IfModule Litespeed>
    # LiteSpeed specific optimizations
    CacheLookup public on
</IfModule>

# Disable directory listing
Options -Indexes

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home2/xmartguard/app.xmartguard.com"
PassengerBaseURI "/"
PassengerNodejs "/home2/xmartguard/nodevenv/app.xmartguard.com/22/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END
